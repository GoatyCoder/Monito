# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET=change_me_in_production_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bcrypt
BCRYPT_SALT_ROUNDS=12
